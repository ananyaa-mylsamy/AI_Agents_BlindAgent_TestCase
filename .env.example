# Copy this file to .env and fill it in. Never commit .env.
OPENAI_API_KEY=
# The exact OpenAI API model id. The same model runs the agent and Hope.
OPENAI_MODEL=
# Safety switch: no API call is made unless this is 1.
ALLOW_API_CALLS=0
# A run stops once this many tokens (agent + Hope) have been used.
MAX_TOKENS_PER_RUN=300000
# Host port for opening the site in your own browser (macOS AirPlay uses 5000).
HOST_PORT=5050